# Mobile environment variables (prefixed with EXPO_PUBLIC_)
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_ENV=dev

# API environment variables
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/perspective?schema=public
JWT_ACCESS_SECRET=super-secret-jwt-access-key-minimum-32-chars
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-minimum-32-chars

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Expo push / notifications
EXPO_ACCESS_TOKEN=your_expo_access_token
