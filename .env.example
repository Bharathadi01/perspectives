# Copy to apps/api/.env for the API. Never commit real secrets.

# ---------- Mobile (only EXPO_PUBLIC_* reaches the app bundle; none may be secret) ----------
# Use your computer's LAN IP instead of localhost when testing on a phone with Expo Go.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_ENV=dev

# ---------- API ----------
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://perspective:perspective@localhost:5432/perspective?schema=public
# e2e tests use this database (it is truncated by the tests)
TEST_DATABASE_URL=postgresql://perspective:perspective@localhost:5432/perspective_test?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-1
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-2
MEDIA_SIGNING_SECRET=replace-with-at-least-32-random-characters-3
# Development media storage (the canonical provider replaces this)
MEDIA_STORAGE_DIR=./.data/media

# ---------- Product configuration (docs/PRODUCT.md) ----------
# Timezone that defines "today" for the daily set
APP_TIMEZONE=Asia/Kolkata
# Most mandatory perspectives per day; the actual count is 1, 2 or 3 by how many people are available
DAILY_MANDATORY_COUNT=3
# People available at which the set is 3 (and 5 more after the set), and at which it is 2 (and 4 more)
POOL_FULL_AT=15
POOL_PARTIAL_AT=6
# Automatic age widening when fewer than POOL_PARTIAL_AT people are available: years per step at each end, and the most beyond the chosen range (0 = off)
AUDIENCE_WIDEN_STEP_YEARS=2
AUDIENCE_WIDEN_MAX_YEARS=4
# Days before re-requesting a connect after a decline (0 disables)
CONNECT_DECLINE_COOLDOWN_DAYS=14
# Connect requests a person may send per day (empty = unlimited)
MAX_CONNECT_REQUESTS_PER_DAY=5
# Optional hard cap on perspectives received per profile per day (empty = none; the product has no hard cap)
MAX_PERSPECTIVES_RECEIVED_PER_DAY=
# Soft limit: after this many received today, no more mandatory sets for that person today (0 = off)
RECEIVED_SOFT_LIMIT_PER_DAY=10
# Not opened the app for this many days: never put into a mandatory set (0 = off)
MANDATORY_INACTIVE_DAYS=7
# How long a skipped profile stays out of Explore
SKIP_HIDE_DAYS=2
# "Recently" for the boost (no perspectives in this many days) and for need in the ranking
BOOST_LOOKBACK_DAYS=3
# Over-exposure: most daily sets one profile can be in per day (0 = no cap)
MAX_MANDATORY_ASSIGNMENTS_PER_PROFILE_PER_DAY=6
# Boost is picked at random from this many least-served profiles (1 = always the single least-served)
BOOST_CANDIDATE_POOL=5
# Boost only for owners active today or this many days before (0 = no check), or accounts younger than the hours below
BOOST_ACTIVE_DAYS=3
BOOST_NEW_PROFILE_HOURS=48
# Distinct reporters within the window that keep a profile out of every daily set (0 = off)
REPORT_LOOKBACK_DAYS=30
REPORT_PAUSE_REPORTERS=2
# Different reporters in the window that put someone on hold (hidden from new people, on the admin's list; 0 = off)
REPORT_HOLD_REPORTERS=3
# Days of a temporary ban, and of each extension
BAN_TEMPORARY_DAYS=3
# Weak givers: the line, minimum low-effort marks and people, marks for the admin flag, ranking penalty, fade
WEAK_GIVER_LINE=0.6
WEAK_GIVER_MIN_MARKS=8
WEAK_GIVER_MIN_MARKERS=5
WEAK_GIVER_FLAG_MARKS=10
WEAK_GIVER_PENALTY=0.2
MARK_FADE_DAYS=45
# Owners who mark more than this share of what they receive as not helpful (with at least this many marks) count half
HARSH_MARKER_SHARE=0.8
HARSH_MARKER_MIN_MARKS=10
# Admin sign-in needs the 6-digit authenticator code (off for now, decided 2026-10-21; turn on before the beta)
ADMIN_REQUIRE_CODE=false
# Admin dashboard sessions (hours, no renewal). ADMIN_JWT_SECRET is optional; without it one is derived from JWT_ACCESS_SECRET
ADMIN_SESSION_HOURS=8
# Ranking weights: shared interests, need, recently active, new member, giving quality
RANK_WEIGHT_INTERESTS=0.45
RANK_WEIGHT_NEED=0.2
RANK_WEIGHT_ACTIVE=0.15
RANK_WEIGHT_NEW_MEMBER=0.1
RANK_WEIGHT_QUALITY=0.1
RANK_WEIGHT_FRESH=0.1
# Quiet connections close on their own (docs/PRODUCT.md)
FIRST_REPLY_WARN_HOURS=24
FIRST_REPLY_CLOSE_HOURS=48
FIRST_REPLY_BACKSTOP_DAYS=7
NO_MESSAGE_REMIND_DAYS=2
NO_MESSAGE_CLOSE_DAYS=3
INACTIVITY_CLOSE_DAYS=14
# Days before a pair whose connection closed on its own can connect again (0 = straight away)
REOPEN_COOLDOWN_DAYS=0
# Minutes between sweeps that close quiet connections nobody opened (0 disables)
EXPIRY_SWEEP_MINUTES=15
