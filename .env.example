# Copy to apps/api/.env for the API. Never commit real secrets.

# ---------- Mobile (only EXPO_PUBLIC_* reaches the app bundle; none may be secret) ----------
# Use your computer's LAN IP instead of localhost when testing on a phone with Expo Go.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_ENV=dev

# ---------- API ----------
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://perspective:perspective@localhost:5432/perspective?schema=public
# e2e tests use this database (it is truncated by the tests)
TEST_DATABASE_URL=postgresql://perspective:perspective@localhost:5432/perspective_test?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-1
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-2
MEDIA_SIGNING_SECRET=replace-with-at-least-32-random-characters-3
# Development media storage (the canonical provider replaces this)
MEDIA_STORAGE_DIR=./.data/media

# ---------- Product configuration (docs/PRODUCT.md) ----------
# Timezone that defines "today" for the daily set
APP_TIMEZONE=Asia/Kolkata
# Mandatory perspectives per day before your own unlock
DAILY_MANDATORY_COUNT=3
# Finite daily Explore batch (mandatory set included)
DAILY_BATCH_SIZE=10
# Days before re-requesting a connect after a decline (0 disables)
CONNECT_DECLINE_COOLDOWN_DAYS=14
# Caps: empty means unlimited (product default until tuned)
MAX_CONNECT_REQUESTS_PER_DAY=
MAX_PERSPECTIVES_RECEIVED_PER_DAY=
# How long a skipped profile stays out of Explore
SKIP_HIDE_DAYS=7
BOOST_LOOKBACK_DAYS=7
# Over-exposure: most daily sets one profile can be in per day (0 = no cap)
MAX_MANDATORY_ASSIGNMENTS_PER_PROFILE_PER_DAY=6
# Boost is picked at random from this many least-served profiles (1 = always the single least-served)
BOOST_CANDIDATE_POOL=5
# Boost only for owners active today or this many days before (0 = no check), or accounts younger than the hours below
BOOST_ACTIVE_DAYS=3
BOOST_NEW_PROFILE_HOURS=48
# Distinct reporters within the window that keep a profile out of every daily set (0 = off)
REPORT_LOOKBACK_DAYS=30
REPORT_PAUSE_REPORTERS=2
# Quiet connections close on their own (docs/PRODUCT.md)
FIRST_REPLY_WARN_HOURS=24
FIRST_REPLY_CLOSE_HOURS=48
FIRST_REPLY_BACKSTOP_DAYS=7
NO_MESSAGE_REMIND_DAYS=2
NO_MESSAGE_CLOSE_DAYS=3
INACTIVITY_CLOSE_DAYS=14
# Days before a pair whose connection closed on its own can connect again (0 = straight away)
REOPEN_COOLDOWN_DAYS=0
# Minutes between sweeps that close quiet connections nobody opened (0 disables)
EXPIRY_SWEEP_MINUTES=15
