{
  "name": "perspectives",
  "version": "0.1.0",
  "private": true,
  "description": "Structured human-feedback and mutual-connection platform",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev:api": "pnpm --filter @perspective/api dev",
    "dev:mobile": "pnpm --filter @perspective/mobile start",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @perspective/api test:e2e",
    "db:migrate": "pnpm --filter @perspective/api prisma:migrate",
    "db:seed": "pnpm --filter @perspective/api db:seed"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "prettier": "^3.5.0"
  }
}
