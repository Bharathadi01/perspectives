// Perspective data model. Business rules: docs/PRODUCT.md. Table notes: docs/DATABASE.md.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// active, suspended (a ban with an end date, `suspendedUntil`) or banned (permanent). Decided 2026-10-20.
enum UserStatus {
  active
  suspended
  banned
}

/// Why someone is in the admin's review list (docs/PRODUCT.md → Reports, holds and bans).
enum ReviewReason {
  reporters
  serious_report
  weak_giver
}

enum ReviewOutcome {
  dismissed
  banned_temporary
  banned_permanent
}

enum BanKind {
  temporary
  permanent
}

enum AppealStatus {
  open
  upheld
  restored
}

enum AdminRole {
  admin
}

enum Gender {
  woman
  man
  non_binary
}

enum Orientation {
  straight
  gay
  lesbian
  bisexual
  pansexual
  queer
  asexual
  prefer_not_to_say
}

/// The private onboarding goal (decided 2026-10-20). A person picks one or both; never shown to anyone.
enum ProfileGoal {
  get_perspectives
  meet_people
}

/// Kinds of in-app notice. Step 2 of the beta adds the automatic age widening only.
enum NoticeKind {
  audience_widened
  weak_giver_tip
  account_restored
}

/// Unused since 2026-10-20 (replaced by ProfileGoal). Kept because migrations are additive only.
enum DatingIntention {
  long_term
  long_term_open
  short_term_open
  casual
  friendship
  figuring_out
}

enum LifestylePace {
  early_bird
  night_owl
  balanced
  active_adventurer
  laid_back
}

enum SocialPreference {
  introvert
  extrovert
  ambivert
  small_groups
  social_butterfly
}

enum SelfieStatus {
  unverified
  verified
  rejected
}

enum MediaKind {
  photo
  audio
}

enum MediaPurpose {
  post
  selfie
}

enum PostKind {
  photo
  audio
  text
}

enum PostCategory {
  style
  grooming
  fitness
  looks
  voice
  vibe
  personality
  profile
  interests
  lifestyle
  other
}

enum PostStatus {
  pending_moderation
  active
  paused
  removed
  archived
}

enum PerspectiveStatus {
  submitted
  pending_moderation
  delivered
  helpful
  archived
  reported
  removed
}

enum FeedbackVerdict {
  helpful
  not_helpful
}

enum NotHelpfulReason {
  vague
  irrelevant
  insulting
  sexual
  spam
  unsafe
}

enum AssignmentSlot {
  boost
  mandatory
}

enum AssignmentStatus {
  pending
  given
  skipped
  replaced
}

enum ConnectRequestStatus {
  pending
  accepted
  declined
  cancelled
}

enum ConnectionStatus {
  active
  unmatched
  blocked
}

/// Why a quiet connection was closed automatically (it then has status `unmatched`).
enum ConnectionCloseReason {
  no_reply
  no_message
  inactive
}

enum ReportTargetType {
  profile
  post
  perspective
  message
}

enum ReportReason {
  nudity_sexual
  body_shaming
  harassment_hate
  threat_violence
  self_harm
  scam_impersonation
  underage
  spam
  other
}

enum ReportStatus {
  unreviewed
  human_review
  allowed
  removed
}

enum DeletionJobStatus {
  pending
  completed
  failed
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String
  birthDate       DateTime   @db.Date
  status          UserStatus @default(active)
  /// End of a temporary ban (status suspended). The account returns to active by itself afterwards.
  suspendedUntil  DateTime?
  termsAcceptedAt DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  profile           Profile?
  refreshTokens     RefreshToken[]
  media             Media[]
  posts             Post[]
  perspectivesGiven Perspective[]       @relation("Giver")
  perspectivesOwned Perspective[]       @relation("Owner")
  dailyProgress     DailyProgress[]
  assignments       DailyAssignment[]   @relation("AssignmentViewer")
  assignedTo        DailyAssignment[]   @relation("AssignmentTarget")
  skipsMade         ProfileSkip[]       @relation("SkipViewer")
  skipsReceived     ProfileSkip[]       @relation("SkipTarget")
  requestsSent      ConnectRequest[]    @relation("RequestSender")
  requestsReceived  ConnectRequest[]    @relation("RequestReceiver")
  connectionsA      Connection[]        @relation("ConnectionA")
  connectionsB      Connection[]        @relation("ConnectionB")
  messages          Message[]
  blocksMade        Block[]             @relation("Blocker")
  blocksReceived    Block[]             @relation("Blocked")
  reportsFiled      Report[]
  idempotency       IdempotencyRecord[]
  notices           Notice[]
  reviewCases       ReviewCase[]
  bans              Ban[]
  appeals           Appeal[]
  giverQuality      GiverQuality?

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Profile {
  userId               String            @id @db.Uuid
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName          String?
  gender               Gender?
  heightCm             Int?
  orientation          Orientation?
  city                 String?
  pronouns             String?
  goals                ProfileGoal[]     @default([])
  audienceGenders      Gender[]          @default([])
  /// The age range in use for matching. Equal to the chosen range unless it was widened automatically.
  audienceMinAge       Int?
  audienceMaxAge       Int?
  /// The age range the person last chose themselves; automatic widening is measured from it.
  audienceChosenMinAge Int?
  audienceChosenMaxAge Int?
  /// Unused since 2026-10-20: the dating intention and its dealbreaker were removed (ADR-018).
  datingIntention      DatingIntention?
  intentionDealbreaker Boolean           @default(false)
  interests            String[]          @default([])
  lifestylePace        LifestylePace?
  socialPreference     SocialPreference?
  personalityPrompts   Json?
  selfieStatus         SelfieStatus      @default(unverified)
  selfieMediaId        String?           @db.Uuid
  selfieCheckedAt      DateTime?
  /// True when basics, audience, selfie, and a primary photo post are all in place.
  isLive               Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([isLive, gender])
  @@map("profiles")
}

/// The in-app notices list (You → Notices). `dedupeKey` stops the same notice being written twice.
model Notice {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NoticeKind
  data      Json
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime   @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("notices")
}

model Media {
  id          String       @id @default(uuid()) @db.Uuid
  ownerId     String       @db.Uuid
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind        MediaKind
  purpose     MediaPurpose @default(post)
  mimeType    String
  storageKey  String       @unique
  byteSize    Int
  durationSec Float?
  createdAt   DateTime     @default(now())

  post      Post? @relation("PostMedia")
  postAudio Post? @relation("PostAudioMedia")

  @@index([ownerId])
  @@map("media")
}

model Post {
  id           String       @id @default(uuid()) @db.Uuid
  ownerId      String       @db.Uuid
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  position     Int
  kind         PostKind
  mediaId      String?      @unique @db.Uuid
  media        Media?       @relation("PostMedia", fields: [mediaId], references: [id], onDelete: Cascade)
  audioMediaId String?      @unique @db.Uuid
  audioMedia   Media?       @relation("PostAudioMedia", fields: [audioMediaId], references: [id], onDelete: SetNull)
  prompt       String
  category     PostCategory
  focusAreas   String[]
  status       PostStatus   @default(active)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  perspectives Perspective[]

  @@index([ownerId, status, position])
  @@map("posts")
}

model Perspective {
  id               String            @id @default(uuid()) @db.Uuid
  postId           String            @db.Uuid
  post             Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  giverId          String            @db.Uuid
  giver            User              @relation("Giver", fields: [giverId], references: [id], onDelete: Cascade)
  /// Denormalized post owner, for inbox and gate queries.
  ownerId          String            @db.Uuid
  owner            User              @relation("Owner", fields: [ownerId], references: [id], onDelete: Cascade)
  comment          String
  chips            String[]
  status           PerspectiveStatus @default(delivered)
  verdict          FeedbackVerdict?
  notHelpfulReason NotHelpfulReason?
  thankedAt        DateTime?
  /// When the owner last marked it helpful or not helpful (marks fade after 45 days).
  feedbackAt       DateTime?
  /// Day (app timezone) the perspective was received; drives the daily unlock.
  receivedDayKey   String
  createdAt        DateTime          @default(now())

  connectRequests ConnectRequest[]

  @@unique([postId, giverId], name: "one_perspective_per_giver_per_post")
  @@index([ownerId, receivedDayKey])
  @@index([giverId, ownerId])
  @@map("perspectives")
}

model DailyProgress {
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey        String
  requiredCount Int
  unlockedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@id([userId, dayKey])
  @@map("daily_progress")
}

model DailyAssignment {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation("AssignmentViewer", fields: [userId], references: [id], onDelete: Cascade)
  dayKey    String
  slotIndex Int
  targetId  String           @db.Uuid
  target    User             @relation("AssignmentTarget", fields: [targetId], references: [id], onDelete: Cascade)
  slot      AssignmentSlot
  status    AssignmentStatus @default(pending)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, dayKey, targetId])
  @@index([userId, dayKey, status])
  /// Counts how many sets already hold a profile today (over-exposure cap).
  @@index([targetId, dayKey])
  @@map("daily_assignments")
}

model ProfileSkip {
  id        String   @id @default(uuid()) @db.Uuid
  viewerId  String   @db.Uuid
  viewer    User     @relation("SkipViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  targetId  String   @db.Uuid
  target    User     @relation("SkipTarget", fields: [targetId], references: [id], onDelete: Cascade)
  dayKey    String
  createdAt DateTime @default(now())

  @@index([viewerId, createdAt])
  @@map("profile_skips")
}

model ConnectRequest {
  id             String               @id @default(uuid()) @db.Uuid
  senderId       String               @db.Uuid
  sender         User                 @relation("RequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId     String               @db.Uuid
  receiver       User                 @relation("RequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  /// The perspective that earned this request (the gate).
  perspectiveId  String               @db.Uuid
  perspective    Perspective          @relation(fields: [perspectiveId], references: [id], onDelete: Cascade)
  status         ConnectRequestStatus @default(pending)
  receivedDayKey String
  respondedAt    DateTime?
  createdAt      DateTime             @default(now())

  connection Connection?

  @@index([receiverId, status])
  @@index([senderId, receiverId, status])
  @@map("connect_requests")
}

model Connection {
  id               String                 @id @default(uuid()) @db.Uuid
  /// Normalized pair: userAId < userBId.
  userAId          String                 @db.Uuid
  userA            User                   @relation("ConnectionA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId          String                 @db.Uuid
  userB            User                   @relation("ConnectionB", fields: [userBId], references: [id], onDelete: Cascade)
  status           ConnectionStatus       @default(active)
  originRequestId  String                 @unique @db.Uuid
  originRequest    ConnectRequest         @relation(fields: [originRequestId], references: [id], onDelete: Cascade)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  /// When the pair last became connected (reset when they reconnect); quiet-connection rules count from here.
  connectedAt      DateTime               @default(now())
  /// When each side saw the "you're connected" moment; null means it is still to be shown.
  userASeenAt      DateTime?
  userBSeenAt      DateTime?
  /// When the person who owes the first reply first opened the chat after the first message.
  firstReplySeenAt DateTime?
  closedReason     ConnectionCloseReason?
  closedAt         DateTime?

  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId, status])
  @@index([userBId, status])
  @@map("connections")
}

model Message {
  id           String     @id @default(uuid()) @db.Uuid
  connectionId String     @db.Uuid
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  senderId     String     @db.Uuid
  sender       User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text         String
  createdAt    DateTime   @default(now())

  @@index([connectionId, createdAt, id])
  @@map("messages")
}

model Block {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @db.Uuid
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Report {
  id           String           @id @default(uuid()) @db.Uuid
  /// Kept (as null) after the reporter deletes their account, for safety records.
  reporterId   String?          @db.Uuid
  reporter     User?            @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  targetType   ReportTargetType
  targetId     String           @db.Uuid
  reason       ReportReason
  note         String?
  status       ReportStatus     @default(unreviewed)
  /// The person the report is about (profile owner, post owner, perspective giver or message sender).
  subjectId    String?          @db.Uuid
  /// True when it came from a "not helpful" mark (insulting, sexual or unsafe) instead of the Report button.
  fromFeedback Boolean          @default(false)
  createdAt    DateTime         @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([subjectId, createdAt])
  @@map("reports")
}

/// An entry in the admin's review list. Holds (reporters, serious_report) hide the person from anyone
/// new while open; a weak_giver case only flags them. Closed by an admin (or when they ban).
model ReviewCase {
  id       String         @id @default(uuid()) @db.Uuid
  userId   String         @db.Uuid
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason   ReviewReason
  hides    Boolean
  openedAt DateTime       @default(now())
  closedAt DateTime?
  closedBy String?        @db.Uuid
  outcome  ReviewOutcome?

  @@index([userId, closedAt])
  @@index([closedAt, openedAt])
  @@map("review_cases")
}

/// Every ban an admin gave. The current one is the latest that is not lifted. Extending creates a new
/// ban (so it can be appealed once again) and marks the old one lifted.
model Ban {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      BanKind
  /// Shown to the person on the ban screen.
  reason    String
  endsAt    DateTime?
  createdBy String    @db.Uuid
  createdAt DateTime  @default(now())
  liftedAt  DateTime?
  appeal    Appeal?

  @@index([userId, createdAt])
  @@map("bans")
}

/// One appeal per ban (decided 2026-10-21).
model Appeal {
  id             String       @id @default(uuid()) @db.Uuid
  banId          String       @unique @db.Uuid
  ban            Ban          @relation(fields: [banId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  message        String
  status         AppealStatus @default(open)
  createdAt      DateTime     @default(now())
  decidedAt      DateTime?
  decidedBy      String?      @db.Uuid
  /// Shown to the person when the ban is kept.
  decisionReason String?

  @@index([status, createdAt])
  @@map("appeals")
}

/// Weak-giver state (the quality loop), recomputed after every mark on their perspectives and on their
/// first visit of the day (so faded marks clear it).
model GiverQuality {
  userId         String    @id @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weak           Boolean   @default(false)
  /// When they last went over the line (the private tip was sent then).
  weakSince      DateTime?
  /// When they were put on the admin's list in this episode.
  flaggedAt      DateTime?
  lowEffortMarks Int       @default(0)
  helpfulMarks   Int       @default(0)
  updatedAt      DateTime  @updatedAt

  @@index([weak])
  @@map("giver_quality")
}

/// Admin sign-ins are not Perspective accounts (docs/SECURITY.md). Created only by a server command.
model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  /// Base32 secret for the authenticator app (6-digit code at every sign-in).
  totpSecret   String
  /// Last accepted 30-second step, so a code cannot be used twice.
  lastTotpStep Int?
  role         AdminRole @default(admin)
  createdAt    DateTime  @default(now())
  lastSignInAt DateTime?
  disabledAt   DateTime?

  audit AdminAuditEntry[]

  @@map("admin_users")
}

/// Every admin action and every view of reported content. Never edited from the dashboard.
model AdminAuditEntry {
  id           String    @id @default(uuid()) @db.Uuid
  adminId      String    @db.Uuid
  admin        AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)
  action       String
  targetUserId String?   @db.Uuid
  targetId     String?   @db.Uuid
  reason       String?
  createdAt    DateTime  @default(now())

  @@index([targetUserId, createdAt])
  @@index([createdAt])
  @@map("admin_audit_log")
}

/// Emails that cannot sign up again after a permanent ban.
model BlockedEmail {
  email     String   @id
  createdAt DateTime @default(now())

  @@map("blocked_emails")
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @db.Uuid
  actor        User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  scope        String
  key          String
  statusCode   Int
  responseBody Json?
  createdAt    DateTime @default(now())

  @@unique([actorId, scope, key])
  @@map("idempotency_keys")
}

/// Records that a deletion ran. Holds no personal data and no link to the deleted user.
model DeletionJob {
  id          String            @id @default(uuid()) @db.Uuid
  status      DeletionJobStatus @default(pending)
  createdAt   DateTime          @default(now())
  completedAt DateTime?

  @@index([status, createdAt])
  @@map("deletion_jobs")
}
