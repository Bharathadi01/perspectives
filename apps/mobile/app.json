{
  "expo": {
    "name": "Perspective",
    "slug": "perspective",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.perspective.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EE"
      },
      "package": "com.perspective.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Perspective uses your photos so you can add them to your profile.",
          "cameraPermission": "Perspective uses the camera for selfie verification and profile photos."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Perspective uses the microphone so you can record a short voice post."
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F4EE",
          "resizeMode": "contain"
        }
      ]
    ],
    "scheme": "perspective"
  }
}
